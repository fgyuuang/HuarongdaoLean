#!/bin/sh

while read local_ref local_sha remote_ref remote_sha
do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Direct pushes to main are blocked by HuarongdaoLean collaboration policy." >&2
    echo "Push a personal branch and open a Pull Request for a rotating integrator." >&2
    exit 1
  fi
done

exit 0
